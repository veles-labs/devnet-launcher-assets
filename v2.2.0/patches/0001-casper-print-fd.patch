+//! Process-wide output for the devnet-only `casper_print` host function.
+
+use std::{
+    env,
+    ffi::OsString,
+    io::{self, Write},
+    sync::{Mutex, OnceLock},
+};
+
+#[cfg(unix)]
+use std::{
+    fs::File,
+    os::fd::{FromRawFd, RawFd},
+};
+
+const ENV_VAR: &str = "CASPER_DEVNET_EXPERIMENTAL_PRINT_FD";
+static OUTPUT: OnceLock<Result<Mutex<Output>, io::Error>> = OnceLock::new();
+
+enum Output {
+    Stdout,
+    #[cfg(unix)]
+    Descriptor(File),
+}
+
+impl Output {
+    fn write_line(&mut self, text: &str) -> io::Result<()> {
+        match self {
+            Output::Stdout => writeln!(io::stdout().lock(), "{text}"),
+            #[cfg(unix)]
+            Output::Descriptor(file) => {
+                // File is unbuffered; write_all handles short writes and EINTR.
+                file.write_all(text.as_bytes())?;
+                file.write_all(b"\n")
+            }
+        }
+    }
+}
+
+fn configured_output(value: Option<OsString>) -> io::Result<Output> {
+    let Some(value) = value else {
+        return Ok(Output::Stdout);
+    };
+    #[cfg(unix)]
+    {
+        let fd = value
+            .to_str()
+            .and_then(|value| value.parse::<RawFd>().ok())
+            .filter(|fd| *fd >= 0)
+            .ok_or_else(|| {
+                io::Error::new(
+                    io::ErrorKind::InvalidInput,
+                    format!("{ENV_VAR} must be a non-negative file descriptor number"),
+                )
+            })?;
+        duplicate(fd).map(Output::Descriptor).map_err(|error| {
+            io::Error::new(
+                error.kind(),
+                format!("cannot duplicate {ENV_VAR}={fd}: {error}"),
+            )
+        })
+    }
+    #[cfg(not(unix))]
+    {
+        let _ = value;
+        Err(io::Error::new(
+            io::ErrorKind::Unsupported,
+            "CASPER_DEVNET_EXPERIMENTAL_PRINT_FD requires Unix",
+        ))
+    }
+}
+
+#[cfg(unix)]
+fn duplicate(fd: RawFd) -> io::Result<File> {
+    extern "C" {
+        fn dup(fd: RawFd) -> RawFd;
+    }
+    // SAFETY: dup accepts any integer, returning EBADF for an invalid descriptor.
+    // Do not create a BorrowedFd from an unvalidated environment variable.
+    let duplicated = unsafe { dup(fd) };
+    if duplicated < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    // SAFETY: a successful dup returns a new descriptor owned solely by us.
+    let file = unsafe { File::from_raw_fd(duplicated) };
+    // Use std's close-on-exec clone. The temporary dup is closed on return;
+    // the launcher-provided descriptor is never closed or taken into ownership.
+    file.try_clone()
+}
+
+fn output() -> io::Result<&'static Mutex<Output>> {
+    OUTPUT
+        .get_or_init(|| configured_output(env::var_os(ENV_VAR)).map(Mutex::new))
+        .as_ref()
+        .map_err(|error| io::Error::new(error.kind(), error.to_string()))
+}
+
+pub(crate) fn initialize() -> io::Result<()> {
+    output().map(|_| ())
+}
+
+pub(crate) fn write_line(text: &str) -> io::Result<()> {
+    // Serialize complete calls from execution threads sharing this process.
+    output()?
+        .lock()
+        .unwrap_or_else(|poisoned| poisoned.into_inner())
+        .write_line(text)
+}
